{
  "name": "vigie",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme gamifiée d’apprentissage de la sécurité au travail : cartes à collectionner, quiz et défis.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
